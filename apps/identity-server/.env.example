# Local development only. Copy to .env in this package; shell variables take precedence.
NODE_ENV=development
IDENTITY_SERVER_PORT=3000
DATABASE_URL=postgresql://iam:iam_dev_password@localhost:5432/iam?schema=public
REDIS_URL=redis://127.0.0.1:6379
ISSUER_URL=http://localhost:3000

ACCESS_TOKEN_TTL_SECONDS=600
AUTH_CODE_TTL_SECONDS=120
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# Basic startup/health does not read keys. Provision explicitly for local signing:
# pnpm --filter identity-server dev-keys:generate (never overwrites existing directory).
# M6.5 lazily requires matching RSA >=2048-bit PKCS#8 private/SPKI public PEM files.
# Paths resolve from the process working directory; provision real keys before signing use.
# TOTP key encoding/strength validation remains deferred to its encryption task.
JWT_PRIVATE_KEY_PATH=./dev-keys/private.pem
JWT_PUBLIC_KEY_PATH=./dev-keys/public.pem
JWT_KEY_ID=development-placeholder
TOTP_ENCRYPTION_KEY=development-only-placeholder-not-a-real-key

COOKIE_NAME=iam.sid
# Must be true in production (production ISSUER_URL must also use HTTPS).
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=900

# Generate the client explicitly before typecheck/build/test:
# pnpm --filter identity-server prisma:generate
# After building, verify local Redis separately from unit tests:
# pnpm --filter identity-server redis:check
