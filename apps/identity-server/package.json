{
  "name": "identity-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false && tsc --project tsconfig.prisma.json",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "client:check": "tsx prisma/client.check.ts",
    "client-redirect-uri:check": "tsx prisma/client-redirect-uri.check.ts",
    "scope:check": "tsx prisma/scope.check.ts",
    "client-secret:check": "node --env-file-if-exists=.env dist/client-registry/client-secret.check.js",
    "client-lookup:check": "tsx prisma/client-lookup.check.ts",
    "authorize:check": "tsx prisma/authorization-request.check.ts",
    "token-request:check": "tsx prisma/token-request.check.ts",
    "authorization-code-consume:check": "tsx prisma/authorization-code-consume.check.ts",
    "client-authentication:check": "tsx prisma/client-authentication.check.ts",
    "seed": "pnpm prisma:generate && prisma db seed",
    "seed:check": "tsx prisma/seed.check.ts",
    "redis:check": "node --env-file-if-exists=.env dist/redis/redis.check.js",
    "session:check": "node --env-file-if-exists=.env dist/session/session-state.check.js",
    "login:check": "node --env-file-if-exists=.env dist/auth/login.check.js",
    "logout:check": "node --env-file-if-exists=.env dist/auth/logout.check.js",
    "own-sessions:check": "node --env-file-if-exists=.env dist/auth/own-sessions.check.js",
    "admin-sessions:check": "node --env-file-if-exists=.env dist/auth/admin-session-revocation.check.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "jose": "6.2.12",
    "pg": "^8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
