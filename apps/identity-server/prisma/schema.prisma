generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum ClientType {
  PUBLIC
  CONFIDENTIAL
}

enum RefreshTokenFamilyStatus {
  ACTIVE
  REVOKED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique
  username    String     @unique
  status      UserStatus @default(ACTIVE)
  lockedUntil DateTime?  @map("locked_until")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  credential           Credential?
  sessions             Session[]
  refreshTokenFamilies RefreshTokenFamily[]

  @@map("users")
}

model Credential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credentials")
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  status         SessionStatus @default(ACTIVE)
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")
  lastActivityAt DateTime      @default(now()) @map("last_activity_at")
  expiresAt      DateTime      @map("expires_at")

  user                 User                 @relation(fields: [userId], references: [id])
  refreshTokenFamilies RefreshTokenFamily[]

  @@index([userId])
  @@map("sessions")
}

model RefreshTokenFamily {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  clientId        String                   @map("client_id") @db.Uuid
  sessionId       String                   @map("session_id") @db.Uuid
  status          RefreshTokenFamilyStatus @default(ACTIVE)
  reuseDetectedAt DateTime?                @map("reuse_detected_at")
  revokedAt       DateTime?                @map("revoked_at")
  createdAt       DateTime                 @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, status])
  @@index([clientId, status])
  @@index([sessionId, status])
  @@map("refresh_token_families")
}

model Client {
  id                  String     @id @default(uuid()) @db.Uuid
  clientId            String     @unique @map("client_id")
  name                String
  clientType          ClientType @map("client_type")
  clientSecretHash    String?    @map("client_secret_hash")
  enabled             Boolean    @default(true)
  accessTokenTtl      Int        @default(600) @map("access_token_ttl")
  accessTokenAudience String?    @map("access_token_audience")
  refreshTokenTtl     Int        @default(2592000) @map("refresh_token_ttl")

  redirectUris         ClientRedirectUri[]
  allowedScopes        ClientScope[]
  refreshTokenFamilies RefreshTokenFamily[]

  @@map("clients")
}

model ClientRedirectUri {
  id          String @id @default(uuid()) @db.Uuid
  clientId    String @map("client_id") @db.Uuid
  redirectUri String @map("redirect_uri")

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, redirectUri])
  @@map("client_redirect_uris")
}

model Scope {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  clientScopes ClientScope[]

  @@map("scopes")
}

model ClientScope {
  clientId String @map("client_id") @db.Uuid
  scopeId  String @map("scope_id") @db.Uuid

  client Client @relation(fields: [clientId], references: [id])
  scope  Scope  @relation(fields: [scopeId], references: [id])

  @@id([clientId, scopeId])
  @@map("client_scopes")
}
